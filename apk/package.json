{
  "name": "wsp-heater-switch",
  "version": "0.1.0",
  "private": true,
  "description": "蓝牙热水器开关 —— 手机 APK（Capacitor 外壳 + Web Bluetooth 替换为原生 BLE 插件）",
  "scripts": {
    "sync:web": "node ../tools/sync_site.mjs",
    "add:android": "npx cap add android",
    "sync": "npm run sync:web && npx cap sync android",
    "open": "npx cap open android",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "build:debug:win": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
